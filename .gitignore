# NOTE: .gitignore does NOT support end-of-line comments - a '#' only starts a
# comment at the START of a line. Keep every pattern on its own bare line.

# ---------------------------------------------------------------------------
# Third-party / copyrighted material - MUST NOT be published (see README).
# Xiaomi/YI firmware, the official APK, scraped manufacturer pages, and personal
# sample media. Only our own code and findings ship.
# ---------------------------------------------------------------------------
research/
yi-mirrorless-firmware-tools/
*.apk
*.bin
*.bin.*
*.dng
*.DNG

# Experiment output: captured live-view frames, probe logs, downloaded clips.
# The prose findings in 'fable research/*.md' are kept; raw run output is not.
# NOTE: no leading slash and matched at ANY depth on purpose - the probe scripts
# write to 'yi-m1-remote-control/fable research/wifi-experiment-results/', which an
# anchored 'fable research/...' pattern would NOT catch. These logs contain the
# camera's per-session Wi-Fi password.
wifi-experiment-results/

# Worker-agent scratch space. Holds unpacked firmware sections derived from the
# manufacturer's binary - MUST NOT be published. The task briefs and the prose
# reports in agent-tasks/ itself are ours and may be published.
agent-tasks/work/

# ---------------------------------------------------------------------------
# Build artifacts & environments
# ---------------------------------------------------------------------------
venv/
__pycache__/
*.pyc
*.pyo
build/
dist/
YI M1 Monitor.app/
macos_app_template/AppIcon.icns

yi-m1-ios/YiM1Monitor.xcodeproj/
.build/
DerivedData/
*.xcuserstate

# ---------------------------------------------------------------------------
# OS / editor noise
# ---------------------------------------------------------------------------
.DS_Store
*.swp
.idea/
.vscode/

# ---------------------------------------------------------------------------
# Runtime output
# ---------------------------------------------------------------------------
*.log
